# Local development settings. Copy to .env and adjust.
DATABASE_URL=postgres://mbq:mbq@localhost:5433/mbq
PORT=3001

# Admin sign-in, pick ONE:
#
# 1) No sign-in for /admin while developing locally. Ignored on AWS.
ADMIN_DEV_BYPASS=true
#
# 2) Sign in with a real Cognito user pool (e.g. the staging one). Take the values from the
#    `cdk deploy` outputs and remove ADMIN_DEV_BYPASS above. http://localhost:5173/admin is
#    already an allowed callback URL on the staging pool.
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_DOMAIN=https://<prefix>.auth.<region>.amazoncognito.com
